DATABASE_URL=postgresql://postgres:postgres@localhost:5432/litregre_bet
JWT_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:3000

# LitreGre prediction API (same backend as eaglepredict-nextjs)
PREDICTION_API_BASE_URL=https://mtn.lenhub.net
PREDICTION_API_PHONE=
PREDICTION_API_PIN=
# Or set a long-lived bearer token instead of phone/pin:
# PREDICTION_API_TOKEN=

# Auto-sync fixtures when /api/events is called (default true)
PREDICTION_SYNC_ON_FETCH=true
PREDICTION_SYNC_INTERVAL_MS=900000

# Protect POST /api/cron/sync-events (optional locally)
CRON_SECRET=
